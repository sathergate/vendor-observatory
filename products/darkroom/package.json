{
  "name": "shutterbox",
  "version": "0.1.0",
  "description": "Image processing pipeline for Next.js.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js" }
  },
  "bin": {
    "shutterbox": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=14",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "next": { "optional": true },
    "sharp": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": ["image", "processing", "optimization", "resize", "nextjs", "sharp", "media", "responsive"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sathergate/darkroom" },
  "homepage": "https://github.com/sathergate/darkroom#readme"
}
