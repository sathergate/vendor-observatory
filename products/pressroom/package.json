{
  "name": "pressroom",
  "version": "0.1.0",
  "description": "Type-safe content collections for Next.js.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" }
  },
  "bin": {
    "pressroom": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=14",
    "@modelcontextprotocol/server": ">=1.0.0",
    "zod": ">=3.25.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "next": { "optional": true },
    "@modelcontextprotocol/server": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": ["cms", "content", "mdx", "markdown", "collections", "nextjs", "headless", "blog", "mcp", "claude-code", "ai-coding", "agent-friendly"],
  "claude": {
    "init": "npx pressroom init",
    "mcp": true,
    "category": "headless-cms"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sathergate/pressroom" },
  "homepage": "https://github.com/sathergate/pressroom#readme"
}
